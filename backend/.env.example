# Copy this file to .env and fill in your own values.
# Never commit the real .env file or expose these secrets in the mobile app.

APP_ENV=development

# In production, set APP_ENV=production and replace '*' with the API hostname(s),
# without https://, paths or ports. Example: api.example.com
ALLOWED_HOSTS=*

# Only required if a browser-based client (Flutter Web) calls the API.
# Separate multiple origins with commas. Do not use '*' in production.
CORS_ALLOWED_ORIGINS=

# Per-process fallback limits. Use a shared gateway/Redis limiter for multiple instances.
RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT=120
CHAT_RATE_LIMIT=10

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/descarte_inteligente
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
